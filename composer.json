{
    "name": "javaabu/js-localization",
    "description": "Use your Laravel translations in JavaScript: export them for @javaabu/i18n, load them on Blade pages with no setup, keep them in sync with Vite, find missing lines and fill them with AI.",
    "homepage": "https://github.com/Javaabu/js-localization",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "localization",
        "translations",
        "i18n",
        "javascript",
        "vite"
    ],
    "authors": [
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "javaabu/manifest": "^1.0@dev",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "laravel/ai": "^1.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "laravel/ai": "Fill in missing translations with AI: php artisan lang:translate (^1.0)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\JsLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\JsLocalization\\Tests\\": "tests/",
            "Acme\\Shop\\": "tests/Fixtures/app/vendor/acme/shop/src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\JsLocalization\\JsLocalizationServiceProvider"
            ],
            "aliases": {
                "JsLocalization": "Javaabu\\JsLocalization\\Facades\\JsLocalization"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
