{
  "name": "@javaabu/js-localization",
  "version": "0.0.0",
  "private": true,
  "description": "The JavaScript of javaabu/js-localization: its Vite plugin and the Blade entry that loads @javaabu/i18n. Ships inside the Composer package; apps import it from vendor/javaabu/js-localization.",
  "license": "MIT",
  "author": {
    "name": "Javaabu Pvt. Ltd.",
    "url": "https://javaabu.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javaabu/js-localization.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm build:browser",
    "build:browser": "vite build --config vite.browser.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@javaabu/i18n": "link:../i18n",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
